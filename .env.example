# Vitrine: variáveis de ambiente (somente NOMES; nunca versione valores reais).
# Copie para .env (ignorado pelo Git) e preencha:  cp .env.example .env
# Nenhuma destas variáveis pode ter o prefixo NEXT_PUBLIC_ (são todas de servidor).

# --- Banco de dados (Prisma 7 + better-sqlite3) -------------------------------
# Arquivo SQLite no formato file:CAMINHO.
#   desenvolvimento (rodar a partir da raiz do repositório): file:./dev.db
#   produção (contêiner, caminho ABSOLUTO no volume):        file:/data/vitrine.db
DATABASE_URL=

# --- Autenticação (better-auth 1.7.x) -----------------------------------------
# Segredo que assina os cookies de sessão: longo e aleatório (32+ caracteres).
#   gerar com:  openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública base do site, sem barra final.
#   desenvolvimento: http://localhost:3000     produção: https://meusite.exemplo
BETTER_AUTH_URL=

# --- Administrador inicial (RF22) ---------------------------------------------
# Lidas SOMENTE pelos comandos `npm run admin:create` (executado na instalação e para
# recuperar o acesso quando não resta administrador ativo) e `npm run admin:reset-password`
# (que usa ADMIN_EMAIL e ADMIN_PASSWORD para redefinir a senha de qualquer conta). Os comandos
# são idempotentes e o cadastro público é desabilitado. Depois de usá-los, remova
# ADMIN_PASSWORD do .env.
ADMIN_EMAIL=
# Senha de 8 a 128 caracteres.
ADMIN_PASSWORD=
# Opcional; se vazio, usa "Administrador".
ADMIN_NAME=
# Opcional, só para `admin:create`: o handle do espaço público do administrador (RN20), de 3 a 30
# caracteres [a-z0-9-]; sem ele, o administrador não tem espaço público até ter um handle.
ADMIN_HANDLE=

# --- Limites por usuário (RN25) ------------------------------------------------
# Opcionais; valem para todos os usuários, inclusive o administrador. Inteiros positivos; um valor
# malformado é ignorado e vale o padrão.
# Máximo de conteúdos por usuário, em qualquer estado (padrão 500).
MAX_CONTENTS_PER_USER=
# Máximo do corpo de cada conteúdo, em bytes UTF-8 (padrão 262144, isto é, 256 KiB).
MAX_BODY_BYTES=

# --- Cópia de segurança (RNF10) -----------------------------------------------
# Opcional, só para `npm run db:backup`: diretório onde gravar as cópias do banco (o argumento do
# comando tem precedência). Sem argumento e sem esta variável, o comando recusa. No contêiner, use
# um caminho do volume ou de outro volume montado, ex.: /data/backups.
BACKUP_DIR=
