generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL do banco fica em prisma.config.ts (Prisma 7); em runtime, o driver adapter a recebe.
datasource db {
  provider = "sqlite"
}

// --------------------------------------------------------
// BETTER-AUTH: TABELAS DE AUTENTICAÇÃO E SESSÃO
// --------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // RFC Core (descartável): plugin admin (ADR-023)
  role       String    @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?
  // handle (ADR-024), variante B do Dados: campo próprio, só o administrador escreve
  handle String? @unique
  // variante A (plugin username), só para a comparação da proposta 2
  username        String? @unique
  displayUsername String?
  // senha provisória: o usuário deve trocá-la no primeiro acesso (proposta 3)
  mustChangePassword Boolean @default(false)

  sessions Session[]
  accounts Account[]

  // Relacionamento com o conteúdo do Vitrine
  contents Content[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --------------------------------------------------------
// VITRINE: CONTEÚDO HIERÁRQUICO E CONFIGURAÇÕES
// --------------------------------------------------------

// Estado de publicação do conteúdo. O SQLite não impõe o enum no banco; o Prisma o valida no cliente.
enum ContentStatus {
  DRAFT // Rascunho
  PUBLISHED // Publicado
}

model Content {
  id     String        @id @default(cuid())
  title  String
  slug   String
  body   String?
  type   String // DOCUMENT ou COLLECTION
  status ContentStatus @default(PUBLISHED)
  order  Int           @default(0)

  parentId String?
  parent   Content?  @relation("ContentHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Content[] @relation("ContentHierarchy")

  // Restrict: excluir um usuário com conteúdo é bloqueado, em vez de apagar o conteúdo dele (RNF10)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RN03: slug único entre irmãos. No SQLite o NULL é distinto de NULL, então a unicidade
  // na raiz (parentId nulo) é coberta por um índice parcial na migração SQL (D-05).
  @@unique([parentId, slug])
  // RNF02: consulta da árvore e ordenação dos irmãos (RN05)
  @@index([parentId, order])
  @@map("contents")
}

// Registro único (RN08): o id é fixo e o acesso é sempre por upsert nesse id.
model Configuration {
  id              String  @id @default("default")
  siteName        String  @default("Vitrine")
  siteDescription String?

  primaryColor   String @default("#3b82f6")
  secondaryColor String @default("#1e293b")
  accentColor    String @default("#f59e0b")

  logoUrl    String?
  faviconUrl String?

  // Links sociais exibidos no rodapé (RF24); todos opcionais
  discordUrl   String?
  githubUrl    String?
  youtubeUrl   String?
  instagramUrl String?
  linkedinUrl  String?
  twitchUrl    String?

  updatedAt DateTime @updatedAt

  @@map("configurations")
}
