generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// A URL do banco fica em prisma.config.ts (Prisma 7); em runtime, o driver adapter a recebe.
datasource db {
  provider = "sqlite"
}

// --------------------------------------------------------
// BETTER-AUTH: TABELAS DE AUTENTICAÇÃO E SESSÃO
// --------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Plugin admin do better-auth (ADR-023, ADR-028): papel e suspensão (RN19, RN23)
  role       String    @default("user") // "admin" ou "user"; validado na aplicação (como Content.type)
  banned     Boolean   @default(false)
  banReason  String? // motivo da suspensão, visto pelo usuário
  banExpires DateTime? // fim da suspensão; vencido, a conta volta sozinha (a coluna `banned` só é limpa no login)

  // Identificador público do espaço /{handle} (RN20, ADR-024). Campo próprio, não o `username` do
  // plugin (o usuário o alteraria); só o administrador o define. Nulo até lá; único quando definido.
  handle String? @unique

  // Senha provisória (RN21, ADR-029): enquanto verdadeiro, a conta só troca a senha e lê o perfil
  mustChangePassword Boolean @default(false)

  // Avatar (ADR-034, ADR-037): imagem do tipo `avatar` do próprio usuário. A regra de dono e de
  // tipo é de db.js (replaceImage), não do banco. Único: um avatar pertence a um só usuário.
  avatarImageId String? @unique
  avatarImage   Image?  @relation("UserAvatar", fields: [avatarImageId], references: [id], onDelete: SetNull)

  sessions Session[]
  accounts Account[]

  // Relacionamento com o conteúdo do Vitrine
  contents      Content[]
  notifications Notification[]
  appearance    Appearance?
  images        Image[]        @relation("ImageOwner")
  footerLinks   FooterLink[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Exigida pelo plugin admin; o Vitrine não personifica usuários (sem a permissão `impersonate`)
  impersonatedBy String?

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// --------------------------------------------------------
// VITRINE: CONTEÚDO HIERÁRQUICO E CONFIGURAÇÕES
// --------------------------------------------------------

// Estado de publicação do conteúdo. O SQLite não impõe o enum no banco; o Prisma o valida no cliente.
enum ContentStatus {
  DRAFT // Rascunho
  PUBLISHED // Publicado
}

model Content {
  id     String        @id @default(cuid())
  title  String
  slug   String
  body   String?
  type   String // DOCUMENT ou COLLECTION
  status ContentStatus @default(PUBLISHED)
  order  Int           @default(0)

  // Dono único por árvore (RN13, ADR-028): a chave estrangeira é composta e o banco recusa um filho
  // cujo authorId difere do pai. O `onUpdate: Cascade` leva os descendentes quando o authorId da
  // raiz muda, e é assim que a transferência entre donos é um único UPDATE (RN24).
  parentId String?
  parent   Content?  @relation("ContentHierarchy", fields: [parentId, authorId], references: [id, authorId], onDelete: Cascade, onUpdate: Cascade)
  children Content[] @relation("ContentHierarchy")

  // O dono da árvore inteira. Restrict: excluir um usuário com conteúdo é bloqueado, em vez de
  // apagar o conteúdo dele (RNF10); a exclusão com transferência ou apagamento é feita por db.js.
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Alvo da chave estrangeira composta (parentId, authorId) -> (id, authorId)
  @@unique([id, authorId])
  // RN03: slug único entre irmãos. No SQLite o NULL é distinto de NULL, então a unicidade na raiz
  // (parentId nulo) é coberta, por dono, pelo índice parcial da migração SQL (D-05, ADR-028):
  //   CREATE UNIQUE INDEX "contents_root_owner_slug_key"
  //     ON "contents"("authorId", "slug") WHERE "parentId" IS NULL;
  // O Prisma não o modela e o APAGA sem avisar quando redefine a tabela: toda migração que
  // redefina "contents" deve recriá-lo (risco R16; tests/dados/indexes.test.js confere a presença).
  @@unique([parentId, slug])
  // RNF02, RN05: árvore de um dono e ordenação dos irmãos
  @@index([authorId, parentId, order])
  @@map("contents")
}

// O SITE (portal "/", login e painel): registro único (RN08). O id é fixo e o acesso é sempre por
// upsert nesse id. A aparência de cada usuário fica em `Appearance` (ADR-028).
// Padrões das paletas: Cap. 5 §5.9 (Tabela de paletas padrão; ADR-031). São a BASE de tudo o que
// herda (ADR-038): por isso, aqui as paletas e o nome são obrigatórios, com padrão.
model Configuration {
  id              String  @id @default("default")
  siteName        String  @default("Vitrine")
  siteDescription String?

  // Paleta clara
  primaryColor       String @default("#2563eb")
  secondaryColor     String @default("#1e293b")
  accentColor        String @default("#b45309")
  // Paleta noturna (RN27)
  darkPrimaryColor   String @default("#60a5fa")
  darkSecondaryColor String @default("#cbd5e1")
  darkAccentColor    String @default("#fbbf24")

  // Logo e favicon do site (ADR-034): imagem do tipo certo com `ownerId` nulo. Nulo = padrão
  // embutido (que é do Core e da interface). A regra de tipo e de dono é de db.js.
  logoImageId    String?
  logoImage      Image?  @relation("ConfigurationLogo", fields: [logoImageId], references: [id], onDelete: SetNull)
  faviconImageId String?
  faviconImage   Image?  @relation("ConfigurationFavicon", fields: [faviconImageId], references: [id], onDelete: SetNull)

  // Barra superior (D-34, ADR-037): ao menos um dos dois fica ligado (regra de db.js)
  showLogo Boolean @default(true)
  showName Boolean @default(true)

  // Par de ícones do botão de modo, só do site (D-35): lista fechada em src/lib/footer-icons.js
  modeIconPair   String @default("sun_moon")
  // Título do diretório de espaços do portal (D-38): 1 a 40 caracteres
  directoryTitle String @default("Espaços")

  // Portal "/" (RF30, RN28): só do site, não existem em Appearance
  homeBody         String? // texto do portal, em Markdown
  directoryEnabled Boolean @default(true) // liga o diretório de espaços

  updatedAt DateTime @updatedAt

  @@map("configurations")
}

// Aparência do espaço de um usuário (RF31, ADR-025, ADR-028, ADR-038): sobrescreve a do site no
// espaço e no painel dele. NULO = HERDA do site: as seis cores (a paleta de cada modo, as três
// juntas) e o `siteName` não têm padrão aqui; o padrão fica só em Configuration. Um modo com uma ou
// duas cores nulas é inválido (db.js recusa). A linha nasce sob demanda (upsert no primeiro
// salvamento); sem linha, tudo herda (RN08), e a leitura não escreve.
model Appearance {
  ownerId String @id
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  siteName        String?
  siteDescription String? // não herda

  primaryColor       String?
  secondaryColor     String?
  accentColor        String?
  darkPrimaryColor   String?
  darkSecondaryColor String?
  darkAccentColor    String?

  // Logo e favicon do espaço: imagem do tipo certo e do próprio dono. Nulo = herda (site e, depois,
  // o embutido).
  logoImageId    String?
  logoImage      Image?  @relation("AppearanceLogo", fields: [logoImageId], references: [id], onDelete: SetNull)
  faviconImageId String?
  faviconImage   Image?  @relation("AppearanceFavicon", fields: [faviconImageId], references: [id], onDelete: SetNull)

  // Barra superior do espaço (D-34): não herdam; ao menos um dos dois fica ligado
  showLogo Boolean @default(true)
  showName Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appearances")
}

// Imagem (ADR-034): BLOB no SQLite, já reencodada pelo Core com o `sharp` (sem metadados). Imutável:
// trocar a imagem cria outra linha (id novo) e apaga a anterior. Nenhuma listagem seleciona `bytes`;
// só `getImage(id)` o lê. O banco NÃO impõe que cada referência (avatar, logo, favicon) aponte para
// uma imagem do mesmo dono e do tipo certo: o único caminho de escrita é `replaceImage` (db.js), e um
// teste confere que não há imagem órfã. `ownerId` nulo = imagem do site; a exclusão do usuário apaga
// as dele (db.js, e esta cascata como rede de segurança).
model Image {
  id        String   @id @default(cuid())
  kind      String // avatar, logo ou favicon; validado na aplicação
  mime      String // o da saída reencodada: image/webp (avatar e logo) ou image/png (favicon)
  bytes     Bytes
  width     Int
  height    Int
  sha256    String // do conteúdo reencodado; serve de ETag (não único)
  ownerId   String?
  owner     User?    @relation("ImageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Lados inversos das referências (o Prisma exige os dois lados)
  avatarOf            User?           @relation("UserAvatar")
  siteLogoOf          Configuration[] @relation("ConfigurationLogo")
  siteFaviconOf       Configuration[] @relation("ConfigurationFavicon")
  appearanceLogoOf    Appearance[]    @relation("AppearanceLogo")
  appearanceFaviconOf Appearance[]    @relation("AppearanceFavicon")

  @@index([ownerId])
  @@map("images")
}

// Rodapé por ícones (ADR-035): `ownerId` nulo é o rodapé do site. No máximo 8 por dono e um ícone por
// dono, por db.js (`replaceFooterLinks`, o único caminho de escrita, em lote e transacional). O
// `@@unique` abaixo NÃO cobre o site, pois no SQLite NULL é distinto de NULL; a unicidade do site é o
// índice parcial da migração (SQL manual, o Prisma não o modela e o APAGA sem avisar quando redefine
// a tabela; recriar SEMPRE e conferir em tests/dados/indexes.test.js):
//   CREATE UNIQUE INDEX "footer_links_site_icon_key"
//     ON "footer_links"("icon") WHERE "ownerId" IS NULL;
model FooterLink {
  id        String   @id @default(cuid())
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  icon      String // lista fechada (src/lib/footer-icons.js); validado em db.js
  url       String // https:// ou, no ícone email, mailto:; o formato é validado pelo Core (RN17)
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, icon])
  @@index([ownerId, order])
  @@map("footer_links")
}

// Gravidade de uma notificação. O SQLite não impõe o enum no banco; o Prisma o valida no cliente.
enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

// Notificações internas (RF33, RN26, ADR-026): só o destinatário as vê. O texto exibido não é
// guardado: é montado a partir de `type` e `data`.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // CONTRAST, MODERATION ou ACCOUNT; validado na aplicação
  severity NotificationSeverity @default(INFO)

  // Chave de deduplicação (ex.: "contrast:dark"), única por usuário; nula = sem deduplicação.
  // O NULL é distinto de NULL no SQLite, então as notificações sem chave não colidem.
  dedupeKey String?

  // Parâmetros do evento (campo, razão, motivo, ...) em JSON, como texto. Obrigatório; quem grava
  // e lê é db.js (serializa e desserializa).
  data String

  readAt     DateTime? // lida
  resolvedAt DateTime? // resolvida: a causa deixou de existir
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt // a reabertura de uma deduplicada zera readAt e resolvedAt

  @@unique([userId, dedupeKey])
  // Contador de não lidas e listagem
  @@index([userId, readAt, updatedAt])
  @@map("notifications")
}
