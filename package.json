    "highlight.js": "~11.11.2",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "next": "16.4.0",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
