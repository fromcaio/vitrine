### 1.4 rotas brutas do plugin por papel
{
  "usuário comum cria usuário": {
    "status": 403,
    "code": "YOU_ARE_NOT_ALLOWED_TO_CREATE_USERS",
    "message": "You are not allowed to create users"
  },
  "usuário comum define o próprio papel": {
    "status": 403,
    "code": "YOU_ARE_NOT_ALLOWED_TO_CHANGE_USERS_ROLE",
    "message": "You are not allowed to change users role"
  },
  "usuário comum lista usuários": {
    "status": 403,
    "code": "YOU_ARE_NOT_ALLOWED_TO_LIST_USERS",
    "message": "You are not allowed to list users"
  },
  "sem sessão cria usuário": {
    "status": 401,
    "code": null,
    "message": ""
  },
  "admin cria usuário com role admin": {
    "status": 200,
    "code": null
  }
}

### 1.5 POST /update-user da usuária comum
{
  "{\"role\":\"admin\"}": {
    "status": 400,
    "code": "FIELD_NOT_ALLOWED",
    "message": "role is not allowed to be set"
  },
  "{\"banned\":false}": {
    "status": 400,
    "code": null,
    "message": "No fields to update"
  },
  "{\"handle\":\"ana-2\"}": {
    "status": 400,
    "code": "FIELD_NOT_ALLOWED",
    "message": "handle is not allowed to be set"
  },
  "{\"mustChangePassword\":false}": {
    "status": 400,
    "code": null,
    "message": "No fields to update"
  },
  "{\"name\":\"Ana Souza\",\"role\":\"admin\"}": {
    "status": 400,
    "code": "FIELD_NOT_ALLOWED",
    "message": "role is not allowed to be set"
  },
  "{\"name\":\"Ana Souza\",\"banned\":false,\"handle\":\"ana-2\"}": {
    "status": 400,
    "code": "FIELD_NOT_ALLOWED",
    "message": "handle is not allowed to be set"
  },
  "{\"name\":\"Ana Souza\"}": {
    "status": 200,
    "code": null
  },
  "{\"image\":\"https://exemplo.test/a.png\"}": {
    "status": 200,
    "code": null
  },
  "{\"image\":\"javascript:alert(1)\"}": {
    "status": 200,
    "code": null
  },
  "{\"name\":\"xxxxxxxxxx…(5000 caracteres)\"}": {
    "status": 200,
    "code": null
  }
}

