
### 2A.1 create-user (admin) com data.username: validação e unicidade pelo plugin
{
  "válido": {
    "status": 200,
    "code": null
  },
  "com maiúscula": {
    "status": 400,
    "code": "INVALID_USERNAME",
    "message": "Username is invalid"
  },
  "com sublinhado": {
    "status": 400,
    "code": "INVALID_USERNAME",
    "message": "Username is invalid"
  },
  "hífen na ponta": {
    "status": 400,
    "code": "INVALID_USERNAME",
    "message": "Username is invalid"
  },
  "hífen repetido": {
    "status": 400,
    "code": "INVALID_USERNAME",
    "message": "Username is invalid"
  },
  "curto": {
    "status": 400,
    "code": "USERNAME_TOO_SHORT",
    "message": "Username is too short"
  },
  "longo (31)": {
    "status": 400,
    "code": "USERNAME_TOO_LONG",
    "message": "Username is too long"
  },
  "reservado": {
    "status": 400,
    "code": "INVALID_USERNAME",
    "message": "Username is invalid"
  },
  "duplicado": {
    "status": 400,
    "code": "USERNAME_IS_ALREADY_TAKEN",
    "message": "Username is already taken. Please try another."
  },
  "duplicado só na caixa": {
    "status": 400,
    "code": "INVALID_USERNAME",
    "message": "Username is invalid"
  }
}

