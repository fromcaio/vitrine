@startuml classes-dominio
' ===========================================================================
' Vitrine - Modelo de domínio (diagrama de classes)
' Figura: fig:classes-dominio (doc/tex/capitulos/cap5_arquitetura.tex)
' Espelha prisma/schema.prisma. Atualizar junto com er-vitrine.dbml.
' ===========================================================================
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #475569
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
hide empty methods

enum ContentType <<valor lógico>> {
  DOCUMENT
  COLLECTION
}

enum ContentStatus <<enum do Prisma>> {
  DRAFT
  PUBLISHED
}

class User {
  id : String <<cuid>>
  name : String
  email : String <<único>>
  emailVerified : Boolean
  image : String [0..1]
  createdAt : DateTime
  updatedAt : DateTime
}

class Session {
  id : String <<cuid>>
  token : String <<único>>
  expiresAt : DateTime
  ipAddress : String [0..1]
  userAgent : String [0..1]
  createdAt : DateTime
  updatedAt : DateTime
}

class Account {
  id : String <<cuid>>
  accountId : String
  providerId : String
  password : String [0..1]
  accessToken : String [0..1]
  refreshToken : String [0..1]
  idToken : String [0..1]
  scope : String [0..1]
  createdAt : DateTime
  updatedAt : DateTime
}

class Verification {
  id : String <<cuid>>
  identifier : String
  value : String
  expiresAt : DateTime
}

class Content {
  id : String <<cuid>>
  title : String
  slug : String
  body : String [0..1]
  type : ContentType
  status : ContentStatus = PUBLISHED
  order : Int = 0
  createdAt : DateTime
  updatedAt : DateTime
}

class Configuration <<registro único>> {
  id : String = "default"
  siteName : String = "Vitrine"
  siteDescription : String [0..1]
  primaryColor : String = "#3b82f6"
  secondaryColor : String = "#1e293b"
  accentColor : String = "#f59e0b"
  logoUrl : String [0..1]
  faviconUrl : String [0..1]
  discordUrl : String [0..1]
  githubUrl : String [0..1]
  youtubeUrl : String [0..1]
  instagramUrl : String [0..1]
  linkedinUrl : String [0..1]
  twitchUrl : String [0..1]
  updatedAt : DateTime
}

User "1" *-- "0..*" Session : possui
User "1" *-- "0..*" Account : possui
User "1" *-- "0..*" Content : autor de
Content "0..1" *-- "0..*" Content : pai de
Content ..> ContentType : type
Content ..> ContentStatus : status

note bottom of Content
  Regras: apenas COLLECTION pode ter filhos;
  exclusão de um nó remove seus descendentes (cascata);
  excluir um usuário com conteúdo é bloqueado (Restrict);
  slug único entre irmãos: índice (parentId, slug) mais
  índice parcial para a raiz, em SQL (D-05, ADR-017);
  visível ao público somente se o nó e todos os
  ancestrais forem PUBLISHED (RN15).
end note
note right of Configuration
  Links sociais: seis campos opcionais e
  independentes, apenas URLs http(s) (RN17).
end note
note right of Verification
  Usada pelo better-auth (verificação de e-mail
  e redefinição de senha). Sem relação direta
  com User no schema.
end note
@enduml
