// ////////////////////////////////////////////////////////
// VITRINE - MODELO DE DADOS (DBML)
// Figura: fig:er-vitrine (doc/tex/capitulos/cap5_arquitetura.tex, Apêndice A)
//
// Espelha prisma/schema.prisma (Prisma 7 + SQLite + better-auth).
// REGRA: se o agente Dados alterar prisma/schema.prisma, o Arquiteto atualiza
// este arquivo e o Apêndice A (dicionário de dados) ao integrar o merge.
//
// Base histórica: doc/ref/er.dbml (Relatório de IC: users, contents, configurations).
// Diferenças: (1) tabelas de autenticação do better-auth (user, session, account,
// verification) no lugar da tabela "users" genérica do Auth.js; (2) nomes de coluna
// em camelCase, exatamente como os campos do Prisma (o relatório de IC usava snake_case).
// Atualizado após o merge M-001 (2026-09-30), decisões do Engenheiro Chefe:
//   - D-15: enum ContentStatus (DRAFT | PUBLISHED, padrão PUBLISHED) em contents.status;
//   - D-19: seis links sociais opcionais do rodapé em configurations;
//   - D-01: o nome oficial do projeto é "Vitrine".
// MODELO MULTIUSUÁRIO (ADR-023 a ADR-028 e ADR-031; módulo M15, integrado no merge M-012, 2026-10-04):
//   - user ganha role, banned, banReason, banExpires, handle e mustChangePassword;
//   - session ganha impersonatedBy (plugin admin, sem uso);
//   - contents: dono único por árvore (FK composta), índice parcial da raiz por dono;
//   - configurations (o site) ganha a paleta noturna, homeBody e directoryEnabled;
//   - tabelas novas: appearances (uma por usuário) e notifications;
//   - padrões das cores: ADR-031 (clara) e Cap. 5 §5.9 (noturna).
// Espelha prisma/schema.prisma e a migração 20261004120000_multiusuario.
// Renderizar: https://dbdiagram.io (colar o conteúdo e exportar PNG) - ver README.
// ////////////////////////////////////////////////////////

Project vitrine {
  database_type: 'SQLite'
  Note: 'Nomes de tabela conforme @@map do Prisma; nomes de coluna conforme os campos do model.'
}

// ////////////////////////////////////////////////////////
// AUTENTICAÇÃO E SESSÃO (gerenciadas pelo better-auth)
// ////////////////////////////////////////////////////////
Table user {
  id varchar [pk, note: 'cuid()']
  name varchar [not null]
  email varchar [unique, not null]
  emailVerified boolean [not null]
  image varchar [note: 'URL da foto do perfil']
  role varchar [not null, default: 'user', note: 'admin | user (plugin admin; RN19)']
  banned boolean [not null, default: false, note: 'Conta suspensa (RN23)']
  banReason varchar [note: 'Motivo da suspensão, visto pelo usuário']
  banExpires timestamp [note: 'Fim da suspensão; vencido, a conta volta sozinha']
  handle varchar [unique, note: 'Identificador público do espaço (RN20); nulo até o administrador defini-lo']
  mustChangePassword boolean [not null, default: false, note: 'Troca de senha obrigatória (RN21)']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null, note: '@updatedAt']
}

Table session {
  id varchar [pk]
  expiresAt timestamp [not null]
  token varchar [unique, not null]
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  ipAddress varchar
  userAgent varchar
  impersonatedBy varchar [note: 'Exigido pelo plugin admin; sem uso (sem permissão impersonate)']
  userId varchar [not null]
}

Table account {
  id varchar [pk]
  accountId varchar [not null]
  providerId varchar [not null, note: 'identificador do provedor de login']
  userId varchar [not null]
  accessToken varchar
  refreshToken varchar
  idToken varchar
  accessTokenExpiresAt timestamp
  refreshTokenExpiresAt timestamp
  scope varchar
  password varchar [note: 'hash da senha (login com e-mail e senha)']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table verification {
  id varchar [pk]
  identifier varchar [not null]
  value varchar [not null]
  expiresAt timestamp [not null]
  createdAt timestamp [default: `now()`]
  updatedAt timestamp
}

// ////////////////////////////////////////////////////////
// ESTADO DE PUBLICAÇÃO (enum do Prisma; o SQLite não impõe o valor no banco)
// ////////////////////////////////////////////////////////
Enum ContentStatus {
  DRAFT [note: 'Rascunho: não aparece ao público']
  PUBLISHED [note: 'Publicado (padrão): visível ao público']
}

// ////////////////////////////////////////////////////////
// CONTEÚDO HIERÁRQUICO
// ////////////////////////////////////////////////////////
Table contents {
  id varchar [pk]
  title varchar [not null]
  slug varchar [not null, note: 'URL amigável']
  body text [note: 'Conteúdo em Markdown']
  type varchar [not null, note: 'DOCUMENT | COLLECTION']
  status ContentStatus [not null, default: 'PUBLISHED', note: 'Visível ao público somente se o nó e todos os ancestrais forem PUBLISHED (RN15)']
  order integer [not null, default: 0, note: 'Ordenação entre irmãos']

  // Auto-relacionamento para estrutura de árvore
  parentId varchar [note: 'ID do conteúdo pai (null se for raiz)']

  authorId varchar [not null, note: 'Dono da árvore inteira (RN13); excluir um usuário com conteúdo é bloqueado (Restrict, RNF10)']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (parentId, slug) [unique, name: 'contents_parentId_slug_key', note: 'RN03: slug único entre irmãos']
    (authorId, slug) [unique, name: 'contents_root_owner_slug_key', note: 'Índice parcial (migração SQL manual): UNIQUE (authorId, slug) WHERE parentId IS NULL; raiz por dono, onde o SQLite trata NULL como distinto (D-05, ADR-028)']
    (id, authorId) [unique, name: 'contents_id_authorId_key', note: 'Alvo da chave estrangeira composta (parentId, authorId) -> (id, authorId)']
    (authorId, parentId, order) [name: 'contents_authorId_parentId_order_idx', note: 'RNF02, RN05: árvore de um dono e ordenação dos irmãos']
  }
}

// ////////////////////////////////////////////////////////
// CONFIGURAÇÕES DE UI E BRANDING (registro único)
// ////////////////////////////////////////////////////////
Table configurations {
  id varchar [pk, default: 'default', note: 'Registro único (RN08): id fixo "default"; acesso sempre por upsert']
  siteName varchar [not null, default: 'Vitrine']
  siteDescription text

  // Variáveis de identidade visual
  // Paleta clara (ADR-031) e noturna (Cap. 5, 5.9); o site é o do administrador (portal, login, painel)
  primaryColor varchar [not null, default: '#2563eb']
  secondaryColor varchar [not null, default: '#1e293b']
  accentColor varchar [not null, default: '#b45309']
  darkPrimaryColor varchar [not null, default: '#60a5fa']
  darkSecondaryColor varchar [not null, default: '#cbd5e1']
  darkAccentColor varchar [not null, default: '#fbbf24']

  // Portal "/" (RF30, RN28)
  homeBody text [note: 'Texto do portal, em Markdown']
  directoryEnabled boolean [not null, default: true, note: 'Liga o diretório de espaços']

  // Metadados adicionais
  logoUrl varchar
  faviconUrl varchar

  // Links sociais do rodapé (RF24, D-19): todos opcionais e independentes;
  // somente URLs http(s) são aceitas (RN17); vazio = ícone não exibido
  discordUrl varchar
  githubUrl varchar
  youtubeUrl varchar
  instagramUrl varchar
  linkedinUrl varchar
  twitchUrl varchar

  updatedAt timestamp [not null]
}

// ////////////////////////////////////////////////////////
// APARÊNCIA POR USUÁRIO (ADR-025, ADR-028): uma linha por usuário, criada sob demanda;
// sem linha, valem os padrões. Mesmas colunas de identidade, links e paletas de
// configurations, sem os campos do portal.
// ////////////////////////////////////////////////////////
Table appearances {
  ownerId varchar [pk]
  siteName varchar [not null, default: 'Vitrine']
  siteDescription text
  primaryColor varchar [not null, default: '#2563eb']
  secondaryColor varchar [not null, default: '#1e293b']
  accentColor varchar [not null, default: '#b45309']
  darkPrimaryColor varchar [not null, default: '#60a5fa']
  darkSecondaryColor varchar [not null, default: '#cbd5e1']
  darkAccentColor varchar [not null, default: '#fbbf24']
  logoUrl varchar
  faviconUrl varchar
  discordUrl varchar
  githubUrl varchar
  youtubeUrl varchar
  instagramUrl varchar
  linkedinUrl varchar
  twitchUrl varchar
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

// ////////////////////////////////////////////////////////
// NOTIFICAÇÕES INTERNAS (ADR-026, ADR-028)
// ////////////////////////////////////////////////////////
Enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

Table notifications {
  id varchar [pk]
  userId varchar [not null, note: 'Destinatário; só ele vê (RN19, RN26)']
  type varchar [not null, note: 'CONTRAST | MODERATION | ACCOUNT (validado na aplicação)']
  severity NotificationSeverity [not null, default: 'INFO']
  dedupeKey varchar [note: 'Ex.: contrast:dark; única por usuário']
  data text [not null, note: 'JSON com os parâmetros do evento']
  readAt timestamp
  resolvedAt timestamp [note: 'A causa deixou de existir']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]

  indexes {
    (userId, dedupeKey) [unique, name: 'notifications_userId_dedupeKey_key']
    (userId, readAt, updatedAt) [name: 'notifications_userId_readAt_updatedAt_idx']
  }
}

// ////////////////////////////////////////////////////////
// RELAÇÕES (como em prisma/schema.prisma; migração 20261001034824_init)
// Cascata em session, account e no auto-relacionamento de contents;
// Restrict no autor do conteúdo (M-002, RNF10).
// ////////////////////////////////////////////////////////
Ref: session.userId > user.id [delete: cascade]
Ref: account.userId > user.id [delete: cascade]
Ref: contents.authorId > user.id [delete: restrict]
Ref: appearances.ownerId - user.id [delete: cascade]
Ref: notifications.userId > user.id [delete: cascade]
// Dono único por árvore (ADR-028): FK composta (parentId, authorId) -> (id, authorId), Cascade
Ref: contents.(parentId, authorId) > contents.(id, authorId) [delete: cascade]

// Auto-relacionamento (no modelo-alvo, a FK composta acima substitui parentId > id):
// um conteúdo pode ter vários "filhos".
// Permite: Tutorial (COLLECTION) > Introdução (DOCUMENT)
// Ref: contents.parentId > contents.id [delete: cascade]   (esquema anterior ao M15, substituída pela FK composta)
