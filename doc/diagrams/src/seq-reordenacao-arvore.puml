@startuml seq-reordenacao-arvore
' ===========================================================================
' Vitrine - Sequência: reordenar e mover conteúdos na árvore
' Figura: fig:seq-reordenacao-arvore (doc/tex/capitulos/cap5_arquitetura.tex)
' Atende RF03 (ordenação entre irmãos) e RF02 (estrutura hierárquica).
' ===========================================================================
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #475569
skinparam sequenceMessageAlign left
autonumber

actor "Administrador" as Admin
participant "ContentTree\n(Client Component)" as Tree
participant "Route Handler\nPATCH /api/contents/reorder" as Api
participant "validators.js\ncontent-tree.js" as Val
participant "db.js" as DB
database "SQLite" as Sql
participant "Cache ISR" as Cache

Admin -> Tree : Arrasta o item (ou usa subir/descer)\npara nova posição ou novo pai
Tree -> Tree : atualização otimista da árvore
Tree -> Api : PATCH [ { id, parentId, order }, ... ]
Api -> Api : exige sessão (better-auth)
Api -> Val : valida o lote
note right of Val
  Regras: pai deve ser COLLECTION;
  sem ciclos (nó não pode ir para dentro
  de um descendante); slugs não colidem
  entre irmãos no destino.
end note

alt lote inválido
  Val --> Api : erros
  Api --> Tree : 422 { error }
  Tree -> Tree : desfaz a atualização otimista
else lote válido
  Api -> DB : getPublicPaths(dono)\n(caminhos de antes)
  Api -> DB : reorderContents(lote)\n(transação)
  DB -> Sql : BEGIN; UPDATE ...; COMMIT
  Api -> Cache : revalidatePath(caminho literal)\npara cada caminho de antes e de depois\n(nunca "layout"; ADR-030)
  Api --> Tree : 200 { árvore atualizada }
end
@enduml
